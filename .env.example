# Copy to .env. Values are baked into the bundle at build time.
#
# EXPO_PUBLIC_ is not a secret prefix — it is the opposite. Anything with this
# prefix is compiled into the JavaScript that ships to every device and can be
# read out of the APK with a text editor. Never put an API key, a token or a
# password here. The only things that belong are addresses.

# Where the API lives.
#   Android emulator reaches your machine at 10.0.2.2, not localhost.
#   A physical device needs your machine's LAN IP.
EXPO_PUBLIC_API_BASE=http://localhost:8100

# Shown in the app's About screen so a tester can say which build they are on.
EXPO_PUBLIC_ENV=development
